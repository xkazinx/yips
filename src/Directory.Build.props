<?xml version="1.0" encoding="utf-8"?>
<!--
  Every project under src\ (yips, kazilib) builds with the 64-bit-hosted compiler,
  linker and librarian (bin\HostX64\x86) and produces x86 (Win32) exes and libs.

  KaziVersion: kazilib (src\dep\kazilib\kazilib.vcxproj) builds its ml version, with
  imgui and imgui-SFML against SFML's headers (src\dep\SFML-3.1.0, setup.ps1).
-->
<Project>
  <PropertyGroup>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <KaziVersion>ml</KaziVersion>
    <KaziDep>$(MSBuildThisFileDirectory)dep\</KaziDep>
    <YipsDep>$(MSBuildThisFileDirectory)dep\</YipsDep>
    <YipsSfml>$(YipsDep)SFML-3.1.0\</YipsSfml>
    <YipsKazilib>$(YipsDep)kazilib\</YipsKazilib>
  </PropertyGroup>
</Project>
